{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["DOM", "ES2020"],
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [],
    "useDefineForClassFields": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
